# ============================================================
# SPPG Cangkring - Contoh konfigurasi lingkungan
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env TIDAK boleh dibagikan atau di-commit.
# ============================================================

# Nama aplikasi (dipakai bila pengaturan database belum tersedia)
APP_NAME="SPPG Cangkring"

# local | production
APP_ENV=local

# Tampilkan detail error di browser. Gunakan false di server produksi.
APP_DEBUG=true

# Kosongkan untuk deteksi otomatis dari folder public/.
# Isi bila aplikasi dipasang pada virtual host, contoh:
# APP_URL=http://localhost/SPPG-Cangkring/public
APP_URL=

# Zona waktu aplikasi
APP_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------
# Koneksi database (MySQL/MariaDB)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sppg_cangkring
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------
# Sesi dan autentikasi
# ------------------------------------------------------------
SESSION_NAME=sppg_session
SESSION_LIFETIME=120

# Maksimal percobaan login gagal per kombinasi akun + IP
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Kata sandi admin awal yang dibuat oleh database/install.php.
# Kosongkan untuk memakai kata sandi bawaan yang dicetak installer.
# Minimal 8 karakter, maksimal 72 karakter.
SEED_ADMIN_PASSWORD=
